{
    "name": "@products-monorepo/workflows",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/api/index.ts",
        "build": "tsc",
        "start": "node dist/api/index.js",
        "worker": "tsx src/engine/worker.ts",
        "test": "vitest",
        "test:engine": "tsx src/test-engine.ts",
        "test:engine:direct": "tsx src/test-engine.ts direct",
        "lint": "eslint src --ext .ts",
        "clean": "rimraf dist",
        "db:migrate": "supabase db push"
    },
    "dependencies": {
        "@hono/node-server": "^1.8.0",
        "@hono/zod-validator": "^0.2.0",
        "@products-monorepo/shared": "workspace:*",
        "@supabase/supabase-js": "^2.39.0",
        "bullmq": "^4.16.0",
        "dotenv": "^16.5.0",
        "hono": "^4.0.0",
        "ioredis": "^5.3.2",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.5",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "eslint": "^8.56.0",
        "rimraf": "^5.0.5",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.2.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    }
}
